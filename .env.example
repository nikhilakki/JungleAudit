# Public site URL (used for canonical links, Open Graph, and sitemap.xml at build time)
VITE_SITE_URL=https://jungleaudit.org

# Google Analytics 4 measurement ID (optional — leave empty to disable)
# Create at https://analytics.google.com/ → Admin → Data Streams → Web
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# DuckDB WASM on R2 (required for Cloudflare Pages — assets exceed 25 MiB limit)
# Use assets.jungleaudit.org once connected, or the pub-*.r2.dev URL
# R2 public URL until assets.jungleaudit.org custom domain is connected
VITE_DUCKDB_ASSET_BASE=https://pub-748135acf15d47d78f9dea54bca16470.r2.dev