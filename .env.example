# Public site URL (used for canonical links, Open Graph, and sitemap.xml at build time)
VITE_SITE_URL=https://jungleaudit.org

# Google Analytics 4 measurement ID (optional — leave empty to disable)
# Create at https://analytics.google.com/ → Admin → Data Streams → Web
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# DuckDB WASM on R2 (required for Cloudflare Pages — .wasm exceeds 25 MiB limit)
# Worker .js files are copied to /duckdb/ at build time (same-origin; cross-origin Workers are blocked)
# R2 custom domain (WASM only; worker scripts are same-origin at /duckdb/)
VITE_DUCKDB_ASSET_BASE=https://assets.jungleaudit.org